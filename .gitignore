# ==============================================================================
# Fyno Root Gitignore Configuration
# Covers Node.js/Express Backend, React Native/Expo Frontend, and IDE/OS settings.
# ==============================================================================

# --- Node.js / Dependencies ---
node_modules/
**/node_modules/
package-lock.json.log
pnpm-lock.yaml.log

# --- Environment Variables & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
**/.env
**/.env.example
!**/.env.example
**/.env*.local

# --- Logs & Diagnostics ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
**/logs/

# --- OS / System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Icon?

# --- IDEs, Editors & Tooling ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak
*.tmp
.claude/
.agents/
AGENTS.md

# --- Frontend (Expo & React Native) Specifics ---
.expo/
**/client/.expo/
**/client/dist/
**/client/web-build/
**/client/expo-env.d.ts

# Native Mobile Directories & Build Artifacts (iOS/Android generated folders)
**/client/ios/
**/client/android/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.tsbuildinfo
.metro-health-check*
ip.txt
.xcode.env.local

# --- Testing & Coverage ---
coverage/
**/coverage/
.nyc_output/
