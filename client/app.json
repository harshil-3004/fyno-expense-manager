{
  "expo": {
    "name": "client",
    "slug": "client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Fyno to use the microphone for voice commands.",
        "NSSpeechRecognitionUsageDescription": "Allow Fyno to perform speech recognition for logging expenses."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.client"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Fyno to use the microphone for voice commands.",
          "speechRecognitionPermission": "Allow Fyno to perform speech recognition for logging expenses."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a10fca99-8242-46a4-9742-94fff4560c28"
      }
    }
  }
}
